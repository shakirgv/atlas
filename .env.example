# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, server-only. Needed ONLY for public share links (/s/[token]).
# Supabase -> Project Settings -> API Keys -> secret key (or the legacy service_role key).
# Never prefix with NEXT_PUBLIC_. On Vercel: add it under Environment Variables, then redeploy.
SUPABASE_SERVICE_ROLE_KEY=
